.container {
  min-height: 100vh;
  background-color: #D31526;
  display: flex;
  flex-direction: column;
  padding-bottom: 160rpx;
  overflow: hidden;
}

.status-bar {
  width: 100%;
  background-color: #D31526;
}

.nav-bar {
  width: 100%;
  background-color: #D31526;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.header {
  width: 100%;
  padding: 0 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.header-spacer {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.nav-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.add-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255,255,255,0.1);
  flex-shrink: 0;
}

.add-btn .icon {
  color: #fff;
  font-size: 40rpx;
  font-weight: bold;
}

.icon-img {
  width: 32rpx;
  height: 32rpx;
}

.search-box {
  flex: 1;
  height: 72rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  gap: 16rpx;
  border: 1rpx solid rgba(255,255,255,0.1);
}

.search-icon {
  font-size: 28rpx;
  opacity: 0.6;
}

.search-icon-img {
  width: 32rpx;
  height: 32rpx;
  opacity: 1;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  color: #fff;
  font-size: 22rpx;
  font-family: 'JetBrains Mono', 'SF Mono', 'Monaco', monospace;
  font-weight: 500;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.search-input::placeholder {
  color: rgba(255,255,255,0.6);
}

/* 真机 search placeholder */
.search-placeholder {
  color: rgba(255,255,255,0.6) !important;
  font-size: 22rpx !important;
  font-family: 'JetBrains Mono', 'SF Mono', 'Monaco', monospace;
  font-weight: 500;
  letter-spacing: 4rpx;
}

.card-area {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  margin-top: 20rpx;
}

.bg-card {
  position: absolute;
  width: 620rpx;
  height: 780rpx;
  background: rgba(242,232,207,0.6);
  border-radius: 80rpx;
  border: 1rpx solid rgba(0,0,0,0.05);
}

/* 左右点击热区 */
.hotspots {
  position: absolute;
  top: 30%;
  bottom: 15%;
  left: 0;
  right: 0;
  z-index: 50;
  display: flex;
  pointer-events: none;
}

.hotspot-left {
  width: 25%;
  height: 100%;
  pointer-events: auto;
}

.hotspot-center {
  flex: 1;
  pointer-events: none;
}

.hotspot-right {
  width: 25%;
  height: 100%;
  pointer-events: auto;
}

.volume-card {
  position: absolute;
  width: 620rpx;
  height: 780rpx;
  transition: all 0.5s cubic-bezier(0.23,1,0.32,1);
}

.volume-card.active {
  transform: translate(0, 0) scale(1) rotate(0deg);
  opacity: 1;
}

.volume-card.left {
  transform: translate(280rpx, 30rpx) scale(0.85) rotate(15deg);
  opacity: 0;
  pointer-events: none;
}

.volume-card.right {
  transform: translate(0, 20rpx) scale(0.96) rotate(0deg);
  opacity: 0.4;
  pointer-events: none;
}

/* 作者标签 - 左侧胶囊 */
.author-tag {
  position: absolute;
  top: 100rpx;
  left: -50rpx;
  background: #F2E8CF;
  color: #D31526;
  padding: 22rpx 44rpx;
  border-radius: 40rpx;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  text-transform: uppercase;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.12);
  z-index: 60;
  font-family: 'JetBrains Mono', 'SF Mono', 'Monaco', monospace;
  border: 1rpx solid rgba(211,21,38,0.05);
}

/* 分类标签 - 胶囊样式 */
.classification-tag {
  position: absolute;
  background: #F2E8CF;
  color: #D31526;
  padding: 16rpx 28rpx;
  border-radius: 40rpx;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.1);
  z-index: 60;
  white-space: nowrap;
  white-space: nowrap;
  font-family: 'JetBrains Mono', 'SF Mono', 'Monaco', monospace;
  border: 1rpx solid rgba(211,21,38,0.3); /* Increased opacity for visibility */
}

/* 标签位置 - 分散在卡片周围 */
.tag-0 { top: -60rpx; right: 30rpx; }
.tag-1 { top: 220rpx; right: -50rpx; }
.tag-2 { bottom: 160rpx; left: 30rpx; }
.tag-3 { bottom: 110rpx; right: 50rpx; }
.tag-4 { top: 430rpx; left: -30rpx; }
.tag-5 { top: -20rpx; left: 140rpx; }
.tag-6 { bottom: 250rpx; right: 10rpx; }
.tag-7 { top: 380rpx; left: 30rpx; }

/* 卡片主体 - 文件夹样式 */
.card-content {
  width: 100%;
  height: 100%;
  background: #F2E8CF;
  border-radius: 80rpx;
  display: flex;
  flex-direction: column;
  overflow: visible;
  border: 1rpx solid rgba(0,0,0,0.05);
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.15);
  position: relative;
}

/* 卡片顶部 - 文件夹标签头 */
.card-header {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 160rpx;
  display: flex;
  padding: 30rpx 36rpx 0;
}

.archive-label {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.label-text {
  font-size: 22rpx;
  font-family: 'JetBrains Mono', 'SF Mono', 'Monaco', monospace;
  font-weight: 700;
  color: #D31526;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  opacity: 0.9;
}

.label-sub {
  font-size: 18rpx;
  font-family: 'JetBrains Mono', 'SF Mono', 'Monaco', monospace;
  font-weight: 600;
  color: #D31526;
  opacity: 0.6;
  margin-top: 4rpx;
}

/* 右上角网格装饰 */
.dots-pattern {
  position: absolute;
  top: 30rpx;
  right: 36rpx;
  width: 200rpx;
  height: 80rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  opacity: 0.3;
}

.dots-pattern::before {
  content: '';
  position: absolute;
  width: 100%;
  height: 100%;
  background-image: radial-gradient(circle, #D31526 2rpx, transparent 2rpx);
  background-size: 16rpx 16rpx;
}

.edit-area {
  position: absolute;
  top: 30rpx;
  right: 36rpx;
  display: flex;
  gap: 16rpx;
}

.upload-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(211,21,38,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  background: #F2E8CF;
}

.edit-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(211,21,38,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  background: #F2E8CF;
}

.edit-icon-img {
  width: 40rpx;
  height: 40rpx;
}

/* 卡片主体 - 标题区域 */
.card-body {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 60rpx;
}

/* 标题样式 - 大号衬线斜体 */
.title {
  font-family: 'DM Serif Display', Georgia, 'Times New Roman', serif;
  font-style: italic;
  font-size: 120rpx;
  line-height: 0.85;
  color: #D31526;
  text-transform: uppercase;
  letter-spacing: -2rpx;
  word-break: break-word;
  font-weight: 400;
}

/* 标题下方装饰线 */
.title-divider {
  width: 60rpx;
  height: 4rpx;
  background: #D31526;
  opacity: 0.3;
  margin-top: 40rpx;
  border-radius: 2rpx;
}

/* 右侧竖排 ID */
.archive-id {
  position: absolute;
  right: 36rpx;
  bottom: 120rpx;
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.archive-id text {
  font-size: 18rpx;
  font-family: 'JetBrains Mono', 'SF Mono', 'Monaco', monospace;
  font-weight: 600;
  color: #D31526;
  text-transform: uppercase;
  letter-spacing: 4rpx;
  opacity: 0.4;
  writing-mode: vertical-rl;
  text-orientation: mixed;
}

.empty-state {
  color: rgba(255,255,255,0.2);
  font-family: 'DM Serif Display', Georgia, serif;
  font-style: italic;
  font-size: 48rpx;
  text-align: center;
  padding: 80rpx;
}

/* 底部导航 */
.footer {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
  padding-bottom: 40rpx;
}

.nav-buttons {
  display: flex;
  align-items: center;
  gap: 40rpx;
}

.nav-btn {
  color: #fff;
  font-family: 'JetBrains Mono', 'SF Mono', 'Monaco', monospace;
  font-size: 20rpx;
  text-transform: uppercase;
  letter-spacing: 6rpx;
  font-weight: 700;
}

.nav-btn.disabled {
  opacity: 0.2;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
}

.progress-bar {
  width: 240rpx;
  height: 4rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 2rpx;
  overflow: hidden;
}

.progress {
  height: 100%;
  background: #fff;
  transition: width 0.5s;
}

/* Modal 弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  z-index: 100;
}

.modal-content {
  background: #F2E8CF;
  padding: 80rpx 60rpx;
  border-radius: 50rpx;
  width: 100%;
  border: 1rpx solid rgba(211,21,38,0.1);
  display: flex;
  flex-direction: column;
}

.modal-title {
  display: block;
  font-family: 'DM Serif Display', Georgia, 'Times New Roman', serif;
  font-style: italic;
  font-size: 72rpx;
  font-weight: 400;
  color: #D31526;
  text-align: center;
  margin-bottom: 96rpx;
  text-transform: uppercase;
  letter-spacing: -2rpx;
  line-height: 1.1;
}

.modal-form {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.form-fields {
  flex: 1;
}

.form-group {
  margin-bottom: 80rpx;
}

.form-label {
  display: block;
  font-size: 20rpx;
  font-family: 'JetBrains Mono', 'SF Mono', monospace;
  color: rgba(211,21,38,0.4);
  text-transform: uppercase;
  letter-spacing: 6rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.form-input {
  width: 100%;
  height: auto;
  min-height: 72rpx;
  border: none;
  border-bottom: 2rpx solid rgba(211,21,38,0.1);
  padding: 16rpx 0;
  font-family: 'Newsreader', Georgia, 'Times New Roman', serif;
  font-style: italic;
  font-size: 48rpx;
  font-weight: 400;
  color: #D31526;
  background: transparent;
  line-height: 1.4;
}

.form-input::placeholder {
  color: rgba(211,21,38,0.15);
  font-style: italic;
}

/* 真机 placeholder 样式 */
.input-placeholder {
  color: rgba(211,21,38,0.15) !important;
  font-style: italic;
  font-size: 48rpx;
  font-family: 'Newsreader', Georgia, 'Times New Roman', serif;
}

.form-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 24rpx;
  margin-top: 96rpx;
}

.btn-cancel {
  padding: 28rpx 48rpx;
  font-size: 22rpx;
  font-family: 'JetBrains Mono', 'SF Mono', monospace;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 4rpx;
  color: rgba(211,21,38,0.4);
  border: 2rpx solid rgba(211,21,38,0.1);
  border-radius: 50rpx;
  background: transparent;
}

.btn-save {
  padding: 28rpx 64rpx;
  font-size: 22rpx;
  font-family: 'JetBrains Mono', 'SF Mono', monospace;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 4rpx;
  color: #F2E8CF;
  background: #D31526;
  border-radius: 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(211,21,38,0.25);
}

/* 标签弹窗 */
.tag-popup {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 200;
}

.tag-popup-content {
  background: #F2E8CF;
  width: 100%;
  max-width: 750rpx;
  border-radius: 50rpx 50rpx 0 0;
  padding: 50rpx;
  box-shadow: 0 -30rpx 80rpx rgba(0,0,0,0.25);
}

.popup-handle {
  width: 70rpx;
  height: 8rpx;
  background: rgba(211,21,38,0.15);
  border-radius: 4rpx;
  margin: 0 auto 50rpx;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 36rpx;
}

.popup-title {
  font-size: 20rpx;
  font-family: 'JetBrains Mono', 'SF Mono', 'Monaco', monospace;
  font-weight: 700;
  color: rgba(211,21,38,0.5);
  text-transform: uppercase;
  letter-spacing: 4rpx;
}

.popup-title .highlight {
  color: #D31526;
}

.close-btn {
  color: rgba(211,21,38,0.3);
  font-size: 32rpx;
}

.close-btn-img {
  width: 40rpx;
  height: 40rpx;
}

.tag-volumes-list {
  max-height: 60vh;
}

.tag-volume-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border-radius: 24rpx;
  border: 1rpx solid transparent;
}

.tag-volume-item:active {
  background: rgba(211,21,38,0.05);
  border-color: rgba(211,21,38,0.05);
}

.tag-volume-info {
  flex: 1;
  min-width: 0;
  padding-right: 28rpx;
}

.tag-volume-title {
  display: block;
  font-family: 'DM Serif Display', Georgia, serif;
  font-style: italic;
  font-size: 34rpx;
  color: #D31526;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tag-volume-author {
  display: block;
  font-size: 18rpx;
  font-family: 'JetBrains Mono', 'SF Mono', 'Monaco', monospace;
  color: rgba(211,21,38,0.5);
  text-transform: uppercase;
  letter-spacing: 3rpx;
  margin-top: 8rpx;
  font-weight: 600;
}

.tag-volume-id {
  font-size: 16rpx;
  font-family: 'JetBrains Mono', 'SF Mono', 'Monaco', monospace;
  color: rgba(211,21,38,0.25);
  flex-shrink: 0;
  font-weight: 600;
}
