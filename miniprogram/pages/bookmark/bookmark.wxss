.container {
  min-height: 100vh;
  background-color: #D31526;
  display: flex;
  flex-direction: column;
  padding-bottom: 60rpx;
}

.status-bar {
  width: 100%;
  background-color: #D31526;
}

.header {
  padding: 0 40rpx;
  display: flex;
  align-items: center;
  gap: 30rpx;
  margin-bottom: 60rpx;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: rgba(255,255,255,0.1);
  border: 1rpx solid rgba(255,255,255,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 36rpx;
  transition: all 0.3s;
}

.back-btn:active {
  transform: scale(0.9);
}

.back-icon-img {
  width: 32rpx;
  height: 32rpx;
}

.header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.volume-title {
  color: #fff;
  font-family: 'DM Serif Display', Georgia, serif;
  font-style: italic;
  font-size: 36rpx;
  text-transform: uppercase;
  letter-spacing: -1rpx;
  line-height: 1.1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.volume-author {
  color: rgba(255,255,255,0.6);
  font-size: 16rpx;
  font-family: 'JetBrains Mono', 'SF Mono', 'Monaco', monospace;
  text-transform: uppercase;
  letter-spacing: 4rpx;
  font-weight: bold;
  margin-top: 4rpx;
}

.mark-area {
  flex: 1;
  padding: 0 36rpx;
  display: flex;
  flex-direction: column;
}

.tab-nav {
  display: flex;
  align-items: flex-end;
  margin-bottom: -2rpx;
  position: relative;
  z-index: 20;
  padding: 0 16rpx;
  gap: 0; /* Remove gap between items */
}

.tab-btn {
  flex: 1;
  height: 80rpx;
  background: #E5D9BA;
  color: #D31526;
  font-size: 18rpx;
  font-family: 'JetBrains Mono', 'SF Mono', 'Monaco', monospace;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  clip-path: none;
  border-radius: 0; /* No rounded corners */
  margin-right: 0; /* No gaps */
  opacity: 0.5;
}

.tab-btn.disabled {
  background: rgba(229, 217, 186, 0.3);
  color: rgba(211,21,38,0.2);
}

.tab-active {
  flex: 1.2; /* reduced from 1.5 to be closer to others */
  height: 96rpx;
  background: #F2E8CF;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #D31526;
  font-size: 20rpx;
  font-family: 'JetBrains Mono', 'SF Mono', 'Monaco', monospace;
  font-weight: bold;
  text-transform: uppercase;
  box-shadow: none; /* Shadow doesn't work well with clip-path, remove or simulate */
  z-index: 30;
  clip-path: polygon(0 0, 80% 0, 100% 100%, 0% 100%);
  border-radius: 0;
  padding: 0 16rpx;
}

.tab-active text {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.tab-add {
  flex: 1;
  height: 80rpx;
  background: rgba(211,21,38,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  clip-path: none;
  border-radius: 0;
  opacity: 0.5;
}

.add-icon-img {
  width: 32rpx;
  height: 32rpx;
}

.mark-card {
  flex: 1;
  background: #F2E8CF;
  border: 1rpx solid rgba(0,0,0,0.05);
  padding: 60rpx;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 10;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.2);
  border-radius: 0 0 8rpx 8rpx;
  min-height: 600rpx;
}

.mark-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 60rpx 0;
}

.divider {
  width: 80rpx;
  height: 2rpx;
  background: rgba(211,21,38,0.2);
}

.mark-text {
  font-family: 'DM Serif Display', Georgia, serif;
  font-style: italic;
  font-size: 72rpx;
  line-height: 1.3;
  color: #D31526;
  padding: 80rpx 20rpx;
}

.mark-footer {
  margin-top: auto;
  padding-top: 60rpx;
  border-top: 1rpx solid rgba(211,21,38,0.1);
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 16rpx;
}

.footer-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.footer-item.center {
  align-items: center;
}

.footer-item.right {
  align-items: flex-end;
}

.footer-label {
  font-size: 14rpx;
  font-family: 'JetBrains Mono', 'SF Mono', 'Monaco', monospace;
  text-transform: uppercase;
  letter-spacing: 4rpx;
  color: rgba(211,21,38,0.4);
}

.footer-value {
  font-size: 18rpx;
  font-weight: bold;
  color: #D31526;
  text-transform: uppercase;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 200rpx;
}

.empty-mark {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  opacity: 0.3;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
}

.empty-icon-img {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-family: 'JetBrains Mono', 'SF Mono', 'Monaco', monospace;
  font-size: 20rpx;
  text-transform: uppercase;
  letter-spacing: 4rpx;
  font-weight: bold;
  color: #D31526;
}

.action-bar {
  margin-top: 60rpx;
  padding: 0 36rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.action-btn {
  background: rgba(242,232,207,0.1);
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255,255,255,0.1);
  border-radius: 4rpx;
}

.share-btn {
  background: rgba(242,232,207,0.1);
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255,255,255,0.1);
  border-radius: 4rpx;
  line-height: 1;
  font-size: inherit;
  color: inherit;
}

.share-btn::after {
  display: none;
}

.action-btn:active {
  transform: scale(0.95);
}

.action-icon {
  font-size: 32rpx;
}

.action-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.action-label {
  font-size: 15rpx;
  font-family: 'JetBrains Mono', 'SF Mono', 'Monaco', monospace;
  font-weight: bold;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  margin-top: 8rpx;
  color: #fff;
  text-align: center;
  line-height: 1.2;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  z-index: 100;
}

.modal-content {
  background: #F2E8CF;
  padding: 40rpx;
  border-radius: 40rpx;
  width: 100%;
  max-height: 80vh;
  overflow-y: auto;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.3);
}

.modal-title {
  display: block;
  font-family: 'DM Serif Display', Georgia, 'Times New Roman', serif;
  font-style: italic;
  font-size: 48rpx;
  font-weight: 400;
  color: #D31526;
  text-align: center;
  margin-bottom: 48rpx;
  text-transform: uppercase;
  letter-spacing: -1rpx;
}

.form-group {
  margin-bottom: 30rpx;
}

.form-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.form-label {
  font-size: 18rpx;
  font-family: 'JetBrains Mono', 'SF Mono', 'Monaco', monospace;
  color: rgba(211,21,38,0.6);
  text-transform: uppercase;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.ocr-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(211,21,38,0.05);
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
}

.ocr-icon {
  font-size: 24rpx;
}

.ocr-icon-img {
  width: 28rpx;
  height: 28rpx;
}

.ocr-text {
  font-size: 18rpx;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-weight: 600;
  text-transform: uppercase;
  color: #D31526;
}

.form-textarea {
  width: 100%;
  min-height: 500rpx;
  max-height: 600rpx;
  border: 4rpx solid rgba(211,21,38,0.1);
  padding: 28rpx;
  font-family: 'Newsreader', Georgia, 'Times New Roman', serif;
  font-style: italic;
  font-size: 32rpx;
  color: #D31526 !important;
  border-radius: 24rpx;
  background: #fff;
  line-height: 1.5;
  -webkit-text-fill-color: #D31526;
  box-sizing: border-box;
}

.edit-textarea {
  height: 500rpx;
}

.form-textarea::placeholder {
  color: rgba(211,21,38,0.4);
  font-style: italic;
}

/* 真机 placeholder 样式 */
.input-placeholder {
  color: #C4838A !important;
  font-style: italic;
  font-size: 36rpx;
  line-height: 60rpx;
}

.textarea-placeholder {
  color: #C4838A !important;
  font-style: italic;
  font-size: 32rpx;
}

.form-input {
  width: 100%;
  border: none;
  border-bottom: 2rpx solid rgba(211,21,38,0.1);
  padding: 30rpx 8rpx;
  font-family: 'Newsreader', Georgia, 'Times New Roman', serif;
  font-style: italic;
  font-size: 40rpx;
  height: 100rpx;
  color: #D31526 !important;
  background: transparent;
  -webkit-text-fill-color: #D31526;
  line-height: 1.4;
}

.form-input::placeholder {
  color: rgba(211,21,38,0.4);
  font-style: italic;
}

.form-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 20rpx;
  margin-top: 48rpx;
}

.btn-cancel {
  padding: 28rpx 44rpx;
  font-size: 22rpx;
  font-family: 'JetBrains Mono', 'SF Mono', 'Monaco', monospace;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 4rpx;
  color: rgba(211,21,38,0.4);
  border: 2rpx solid rgba(211,21,38,0.1);
  border-radius: 50rpx;
  background: transparent;
}

.btn-save {
  padding: 28rpx 56rpx;
  font-size: 22rpx;
  font-family: 'JetBrains Mono', 'SF Mono', 'Monaco', monospace;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 4rpx;
  color: #F2E8CF;
  background: #D31526;
  border-radius: 50rpx;
  box-shadow: 0 10rpx 30rpx rgba(211,21,38,0.25);
}

.btn-delete {
  padding: 28rpx 44rpx;
  font-size: 22rpx;
  font-family: 'JetBrains Mono', 'SF Mono', 'Monaco', monospace;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 4rpx;
  color: #fff;
  background: rgba(211,21,38,0.6);
  border-radius: 50rpx;
}

.edit-hint {
  font-size: 20rpx;
  color: rgba(211,21,38,0.3);
  font-family: 'JetBrains Mono', 'SF Mono', 'Monaco', monospace;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin-top: 20rpx;
}

.export-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 750px;
  height: 1000px;
}

.export-modal {
  text-align: center;
}

.export-hint {
  display: block;
  font-size: 28rpx;
  color: rgba(211,21,38,0.6);
  margin-bottom: 48rpx;
}

.export-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.export-btn {
  padding: 32rpx;
  font-size: 28rpx;
  font-family: 'JetBrains Mono', 'SF Mono', 'Monaco', monospace;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  color: rgba(211,21,38,0.6);
  border: 2rpx solid rgba(211,21,38,0.2);
  border-radius: 16rpx;
  background: transparent;
}

.export-btn.primary {
  color: #F2E8CF;
  background: #D31526;
  border: none;
  box-shadow: 0 10rpx 30rpx rgba(211,21,38,0.25);
}

/* Vertical text switch row */
.form-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.form-row switch {
  transform: scale(0.7);
  transform-origin: right center;
  margin-right: -10rpx; /* Compensate for whitespace after scaling */
}

/* Vertical text layout for mark card */
.mark-content.vertical {
  width: 100%;
  flex: 1; /* Ensure it takes available height */
  writing-mode: vertical-rl;
  text-orientation: mixed;
  padding: 40rpx 40rpx;
  overflow-x: auto; /* Enable horizontal scroll */
  overflow-y: hidden; /* No vertical scroll */
  box-sizing: border-box;
  display: block; /* Reset flex display for standard scrolling behavior */
  text-align: left;
}

.mark-content.vertical .mark-text {
  writing-mode: vertical-rl;
  text-orientation: mixed;
  font-size: 32rpx; /* Matches book body text density */
  line-height: 1.6; /* Tighter line height like the reference */
  letter-spacing: 2rpx; /* Standard tracking */
  font-family: 'Songti SC', 'SimSun', 'STSong', 'AR PL New Sung', serif;
  font-style: normal; /* Ensure vertical text is upright */
  font-weight: 500;
  text-align: justify;
  height: 100%;
  white-space: normal;
  color: #D31526; /* Kept red as requested */
  padding: 0 10rpx;
}

.mark-content.vertical .divider,
.mark-content.vertical .edit-hint {
  display: none; /* Hide dividers and hint for clean vertical view */
}
