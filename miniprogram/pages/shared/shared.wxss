.container {
  min-height: 100vh;
  background-color: #D31526;
  display: flex;
  flex-direction: column;
  padding-bottom: 180rpx;
}

.status-bar {
  width: 100%;
  background-color: #D31526;
}

.header {
  padding: 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 60rpx;
}

.header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.volume-title {
  color: #fff;
  font-family: 'DM Serif Display', Georgia, serif;
  font-style: italic;
  font-size: 48rpx;
  text-transform: uppercase;
  letter-spacing: -2rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-align: center;
}

.volume-author {
  color: rgba(255,255,255,0.6);
  font-size: 20rpx;
  font-family: 'JetBrains Mono', 'SF Mono', 'Monaco', monospace;
  text-transform: uppercase;
  letter-spacing: 4rpx;
  font-weight: bold;
  margin-top: 8rpx;
}

.loading-state,
.error-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.loading-text,
.error-text {
  color: rgba(255,255,255,0.6);
  font-size: 28rpx;
  font-family: 'JetBrains Mono', 'SF Mono', 'Monaco', monospace;
  text-transform: uppercase;
  letter-spacing: 4rpx;
  margin-bottom: 40rpx;
}

.mark-area {
  flex: 1;
  padding: 0 36rpx;
  display: flex;
  flex-direction: column;
}

.mark-card {
  flex: 1;
  background: #F2E8CF;
  border: 1rpx solid rgba(0,0,0,0.05);
  padding: 60rpx;
  display: flex;
  flex-direction: column;
  position: relative;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.2);
  border-radius: 8rpx;
  min-height: 600rpx;
}

.mark-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 60rpx 0;
}

.divider {
  width: 80rpx;
  height: 2rpx;
  background: rgba(211,21,38,0.2);
}

.mark-text {
  font-family: 'DM Serif Display', Georgia, serif;
  font-style: italic;
  font-size: 72rpx;
  line-height: 1.3;
  color: #D31526;
  padding: 80rpx 20rpx;
}

.mark-footer {
  margin-top: auto;
  padding-top: 60rpx;
  border-top: 1rpx solid rgba(211,21,38,0.1);
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 16rpx;
}

.footer-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.footer-item.center {
  align-items: center;
}

.footer-item.right {
  align-items: flex-end;
}

.footer-label {
  font-size: 14rpx;
  font-family: 'JetBrains Mono', 'SF Mono', 'Monaco', monospace;
  text-transform: uppercase;
  letter-spacing: 4rpx;
  color: rgba(211,21,38,0.4);
}

.footer-value {
  font-size: 18rpx;
  font-weight: bold;
  color: #D31526;
  text-transform: uppercase;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 200rpx;
}

.action-bar {
  margin-top: 60rpx;
  padding: 0;
  display: flex;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.action-btn {
  flex: 1;
  background: rgba(242,232,207,0.1);
  padding: 32rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255,255,255,0.1);
  border-radius: 8rpx;
}

.action-btn.primary {
  background: #F2E8CF;
  border-color: #F2E8CF;
}

.action-btn.primary .action-label {
  color: #D31526;
}

.action-btn:active {
  transform: scale(0.95);
}

.action-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.action-label {
  font-size: 18rpx;
  font-family: 'JetBrains Mono', 'SF Mono', 'Monaco', monospace;
  font-weight: bold;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  margin-top: 12rpx;
  color: #fff;
  text-align: center;
}
